#include <windows.h>

#define IDI_ICON1   111
#define IDR_AUDIO   112
#define IDR_AUDIO2  113
#define IDR_TOASTPNG 114
#define IDR_AUDIO3  115
#define IDR_AUDIO_ENDERMANCH 117

IDI_ICON1   ICON   "Resources\Icon.ico"
; default track: badapple.wav converted to mono IMA ADPCM (tag 17)
IDR_AUDIO2   RCDATA "Resources\badapple.wav"
IDR_TOASTPNG RCDATA "Resources/toast.png"
; --original track, downmixed to mono IMA ADPCM
IDR_AUDIO3   RCDATA "Resources\original_adpcm.wav"
; --endermanch track: Resources/2.wav (Enderman 2989 soundtrack, IMA ADPCM)
IDR_AUDIO_ENDERMANCH RCDATA "Resources/2.wav"

; --original ending wallpaper frames, played at 30 fps by payload 8.
